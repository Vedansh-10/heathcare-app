# ──────────────────────────────────────────
# AI Healthcare Backend — Environment Config
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# Server
SERVER_PORT=8080

# PostgreSQL
POSTGRES_DB=healthcare_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_PORT=5432

# Spring datasource (used by app service)
DB_URL=jdbc:postgresql://localhost:5432/healthcare_db
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — generate a strong 256-bit secret
# Example: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_256bit_hex_secret
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# CORS (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
